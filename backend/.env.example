PROJECT_NAME=MindVault API
API_V1_STR=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/mindvault

# Google Gemini API Key (Zdobądź darmowy klucz na: https://aistudio.google.com/)
GEMINI_API_KEY=

# Modele
EMBEDDING_MODEL=models/text-embedding-004
CHAT_MODEL=gemini-1.5-flash

# Ustawienia RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RESULTS=4

# Dozwolone originy CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
